[Unit]
Description=WeChat API egress tunnel through public server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gmapp
Group=gmapp
ExecStart=/usr/bin/ssh -NT -i /opt/gm-apps/article/shared/ssh/wechat-egress_ed25519 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/opt/gm-apps/article/shared/ssh/known_hosts -L 127.0.0.1:18888:127.0.0.1:18888 wechat-egress@47.102.223.198
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
